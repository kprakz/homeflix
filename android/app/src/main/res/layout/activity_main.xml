<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOMEFLIX"
            android:textColor="@color/red"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/tagline"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Server -->
        <LinearLayout style="@style/Card">
            <TextView android:id="@+id/status" style="@style/CardTitle" />
            <TextView android:id="@+id/address" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace"
                android:textIsSelectable="true" android:visibility="gone" />
            <ImageView android:id="@+id/qr" android:layout_width="200dp" android:layout_height="200dp"
                android:layout_marginTop="12dp" android:background="@android:color/white" android:padding="8dp"
                android:contentDescription="@string/qr_desc" android:visibility="gone" />
            <TextView android:id="@+id/serverHint" style="@style/CardText" />
            <com.google.android.material.button.MaterialButton android:id="@+id/startStop"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:backgroundTint="@color/red" android:textColor="@color/text" android:textSize="16sp" />
        </LinearLayout>

        <!-- PIN -->
        <LinearLayout style="@style/Card">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/pinOn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pin_title" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/pinText" style="@style/CardText" />
            <com.google.android.material.button.MaterialButton android:id="@+id/newPin" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pin_new" android:textColor="@color/red" />
        </LinearLayout>

        <!-- Folders -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/folders_title" />
            <TextView android:id="@+id/foldersHint" style="@style/CardText" />
            <com.google.android.material.button.MaterialButton android:id="@+id/allowVideos"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:backgroundTint="@color/red" android:textColor="@color/text" android:text="@string/allow_videos" android:visibility="gone" />
            <LinearLayout android:id="@+id/folders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>

        <!-- Storage and heat -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/storage_title" />
            <TextView android:id="@+id/cacheText" style="@style/CardText" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/cacheLimit"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/gb1" style="@style/LimitButton" android:text="1 GB" />
                <com.google.android.material.button.MaterialButton android:id="@+id/gb2" style="@style/LimitButton" android:text="2 GB" />
                <com.google.android.material.button.MaterialButton android:id="@+id/gb4" style="@style/LimitButton" android:text="4 GB" />
                <com.google.android.material.button.MaterialButton android:id="@+id/gb8" style="@style/LimitButton" android:text="8 GB" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/convertVideo"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/convert_title" android:textColor="@color/text" android:textSize="16sp" />
            <TextView style="@style/CardText" android:text="@string/convert_hint" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/heat_title" />
            <TextView android:id="@+id/heatText" style="@style/CardText" />
        </LinearLayout>

        <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:textColor="@color/dim" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
