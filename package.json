{
  "name": "homeflix",
  "productName": "HOMEFLIX",
  "version": "1.3.0",
  "description": "Stream the movies on your laptop to your iPad, phone or TV over your home Wi-Fi.",
  "author": "HOMEFLIX",
  "private": true,
  "repository": "github:kprakz/homeflix",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "ffmpeg": "node scripts/get-ffmpeg.mjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "dist": "node scripts/get-ffmpeg.mjs && electron-builder --win --publish never",
    "dist:mac": "node scripts/get-ffmpeg.mjs && electron-builder --mac --publish never",
    "world-grid": "node scripts/make-world-grid.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "i18n-iso-countries": "^7.14.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "build": {
    "appId": "com.homeflix.app",
    "productName": "HOMEFLIX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HOMEFLIX",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "HOMEFLIX-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "HOMEFLIX-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "HOMEFLIX ${version}"
    }
  }
}
